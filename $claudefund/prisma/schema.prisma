// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Idea {
  id          String    @id @default(cuid())
  email       String
  title       String
  description String
  likes       Int       @default(0)
  status      String    @default("active") // active | funded | rejected
  fundedAt    DateTime?
  createdAt   DateTime  @default(now())
  cycleId     Int       @default(1)

  @@index([status])
  @@index([likes])
  @@index([cycleId])
  @@index([email, cycleId])
}

model Settings {
  id                    Int       @id @default(1)
  submissionsPaused     Boolean   @default(false)
  winnerSelectionPaused Boolean   @default(false)
  lastWinnerSelection   DateTime?
  nextSelectionTime     DateTime?
  currentCycle          Int       @default(1)
}
